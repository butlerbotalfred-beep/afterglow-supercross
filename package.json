{
  "name": "afterglow-supercross",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "lint:lines": "node scripts/check-line-length.mjs",
    "lint:audio": "node scripts/check-audio-ramps.mjs",
    "lint:names": "node scripts/check-rider-names.mjs",
    "build:report": "node scripts/build-report.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "pace-gate": "tsx scripts/pace-gate.ts",
    "landing-harness": "tsx scripts/landing-harness.ts",
    "field-check": "tsx scripts/field-check.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:touch": "node scripts/touch-smoke.mjs",
    "test:load": "node scripts/load-smoke.mjs",
    "art:optimize": "node scripts/optimize-art.mjs",
    "mac:update": "node scripts/mac-update.mjs",
    "test:prod": "node scripts/prod-smoke.mjs",
    "test:hud": "node scripts/hud-layout-check.mjs",
    "test:trial": "node scripts/trial-smoke.mjs",
    "test:gate": "node scripts/gate-smoke.mjs",
    "test:season": "node scripts/season-smoke.mjs",
    "test:rider": "node scripts/rider-smoke.mjs",
    "season-check": "tsx scripts/season-check.ts",
    "start-check": "tsx scripts/start-check.ts",
    "roster-check": "tsx scripts/roster-check.ts",
    "server:install": "node scripts/server-service.mjs install",
    "server:status": "node scripts/server-service.mjs status",
    "server:restart": "node scripts/server-service.mjs restart",
    "server:stop": "node scripts/server-service.mjs stop"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/three": "0.183.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
