{
  "name": "afterglow-supercross",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:touch": "node scripts/touch-smoke.mjs",
    "server:install": "node scripts/server-service.mjs install",
    "server:status": "node scripts/server-service.mjs status",
    "server:restart": "node scripts/server-service.mjs restart",
    "server:stop": "node scripts/server-service.mjs stop"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/three": "0.183.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
